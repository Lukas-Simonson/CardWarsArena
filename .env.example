# Copy to .env next to docker-compose.yml to turn sign-in on. Leave it out for an anonymous server.
# Register an app with Discord (https://discord.com/developers/applications) and/or GitHub
# (Settings > Developer settings > OAuth Apps), with this callback URL:
#   <CARDWARS_PUBLIC_URL>/api/auth/callback/discord   and/or   .../github
CARDWARS_AUTH=oauth
CARDWARS_PUBLIC_URL=https://cards.example.com

CARDWARS_DISCORD_CLIENT_ID=
CARDWARS_DISCORD_CLIENT_SECRET=

CARDWARS_GITHUB_CLIENT_ID=
CARDWARS_GITHUB_CLIENT_SECRET=

# Show links to the project's feedback forms and repository on the home screen (the project's own server).
# CARDWARS_FEEDBACK=1
